# Copy to .env at the workspace root. Never commit .env.
APP_DATA_DIR=.local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Azure Foundry / Azure OpenAI: use the OpenAI v1 endpoint, not a project URL.
# Example: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
# Your Azure deployment name (which may differ from the underlying model name).
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TIMEOUT_SECONDS=60
# Optional: none|minimal|low|medium|high. Leave empty unless the deployment rejects
# function tools with "set reasoning_effort to 'none'" (HTTP 400 azure_http_400).
AZURE_OPENAI_REASONING_EFFORT=
# Live-test metadata. Mailbox sends and automatic processing make live Azure calls.
# The built-in mailbox needs no Outlook or SMTP credentials.
AZURE_OPENAI_LIVE_TESTS_ENABLED=false

# Bounded agent runs; recovery retains elapsed time and usage. Defaults apply when these are omitted from .env.
AGENT_MAX_STEPS=28
AGENT_MAX_MODEL_CALLS=28
AGENT_MAX_SECONDS=300
AGENT_MAX_TOTAL_TOKENS=250000
AGENT_MAX_COMPLETION_TOKENS=1600
AGENT_MAX_CONTEXT_CHARACTERS=100000
