{
  "name": "correspondence-workspace",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mailbox": "vite --config vite.mailbox.config.ts --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.mailbox.config.ts",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.8",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
